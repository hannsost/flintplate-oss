# Example only: replace password/signing-key placeholders before use.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-signing-key
POSTGRES_USER=hireos
POSTGRES_PASSWORD=replace-local-db-password
POSTGRES_DB=hireos
DATABASE_URL=postgresql+asyncpg://hireos:replace-local-db-password@db:5432/hireos
REDIS_PASSWORD=replace-local-redis-password
REDIS_URL=redis://:replace-local-redis-password@redis:6379/0
SCRAPER_IMPORT_KEY=replace-with-an-independent-random-import-key
HIREOS_API_PORT=8001
HIREOS_FRONTEND_PORT=3001
FRONTEND_URL=http://localhost:3012
ALLOWED_ORIGINS=["http://localhost:3012","http://127.0.0.1:3012"]
PUBLIC_REGISTRATION_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
AI_MOCK_MODE=true
AI_MAX_TOKENS=1500
AI_REQUESTS_PER_MIN=20
AGENTS_EXTERNAL_AI_ENABLED=false
BA_CLIENT_ID=
BA_CLIENT_SECRET=
SMTP_HOST=
# Dedicated compose.yaml: generate these with scripts/setup-local.py.
FLINTPLATE_DB_PASSWORD=replace-local-owner-password
FLINTPLATE_RUNTIME_DB_PASSWORD=replace-local-runtime-password
FLINTPLATE_REDIS_PASSWORD=replace-local-redis-password
FLINTPLATE_API_URL=http://127.0.0.1:8012
LEGAL_CONTROLLER_ADDRESS=

# No operator personal/address defaults; fill in verified deployment values.
LEGAL_COMPANY_NAME=
LEGAL_LEGAL_FORM=
LEGAL_REPRESENTED_BY=
LEGAL_STREET=
LEGAL_POSTAL_CODE=
LEGAL_CITY=
LEGAL_CONTACT_EMAIL=
LEGAL_PRIVACY_EMAIL=
LEGAL_REGISTER=
LEGAL_REGISTER_NUMBER=
LEGAL_VAT_ID=
LEGAL_REVIEWED=false

# MCP settings belong in the MCP client environment, not browser configuration.
FLINTPLATE_BASE_URL=http://127.0.0.1:8012
FLINTPLATE_TOKEN=
FLINTPLATE_READ_ONLY=true
